#!/usr/bin/env bash
# gitkamran — единая точка входа в систему бэкапа/восстановления MEDIA Campus.
# Каждый час коммитит и пушит код (campus-infra + helpdesk-ops) в GitHub,
# каждую ночь в 03:00 бэкапит базы данных и вложения в ~/campus-backups.
set -euo pipefail

REPO_DIR="$HOME/projects"
INFRA_DIR="$HOME/projects/campus-infra"
LOG_GITHUB="$HOME/log/backup-to-github.log"
LOG_DATA="$HOME/log/backup-data.log"

usage() {
  cat <<EOF
gitkamran — бэкап/восстановление MEDIA Campus

  gitkamran status     последний бэкап кода и данных, статус крона
  gitkamran run        запустить бэкап кода + данных прямо сейчас
  gitkamran restore    вывести команду полного восстановления с нуля
EOF
}

cmd_status() {
  echo "── Код → GitHub (каждый час) ──"
  tail -n 3 "$LOG_GITHUB" 2>/dev/null || echo "  лога ещё нет"
  echo
  echo "── Данные → ~/campus-backups (ежедневно в 03:00) ──"
  tail -n 3 "$LOG_DATA" 2>/dev/null || echo "  лога ещё нет"
  echo
  echo "── Последний коммит в campus-infra ──"
  git -C "$REPO_DIR" log -1 --format='  %h  %ad  %s' --date=format:'%Y-%m-%d %H:%M' 2>/dev/null || echo "  нет данных"
  echo
  echo "── Крон-задачи gitkamran ──"
  crontab -l 2>/dev/null | grep -E "backup-to-github|backup-data" || echo "  не найдены в crontab"
}

cmd_run() {
  echo "→ Бэкап кода в GitHub..."
  bash "$INFRA_DIR/scripts/backup-to-github.sh"
  echo "→ Бэкап данных (БД + вложения)..."
  bash "$INFRA_DIR/scripts/backup-data.sh"
  echo "Готово."
}

cmd_restore() {
  cat <<EOF
Полное восстановление на новой машине:

  git clone https://github.com/KAbumislimov/campus-infra.git ~/projects/campus-infra
  cd ~/projects/campus-infra
  bash restore.sh

Это скачает код, секреты (спросит GitHub-токен для приватного campus-secrets),
последний бэкап баз данных и вложений из ~/campus-backups, поднимет все контейнеры.

Личные утилиты (campus-mon, gitkamran) восстановятся автоматически —
restore.sh копирует их из personal-bin/ обратно в ~/.local/bin/.
EOF
}

case "${1:-status}" in
  status) cmd_status ;;
  run) cmd_run ;;
  restore) cmd_restore ;;
  *) usage ;;
esac
