[Unit]
Description=Telegram бот Клиент 1а (кнопки, музыка по SSH на клиент)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/tg-campus-bot
EnvironmentFile=/opt/tg-campus-bot/client1.env
ExecStart=/usr/bin/python3 -u /opt/tg-campus-bot/bot_client1.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
