[Unit]
Description=Telegram бот City Garden (cgtk)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
WorkingDirectory=/opt/tg-campus-bot
EnvironmentFile=/opt/tg-campus-bot/cgtk.env
ExecStart=/usr/bin/python3 -u /opt/tg-campus-bot/bot_narimanov.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
[Install]
WantedBy=multi-user.target
