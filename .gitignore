# Секреты — никогда не коммитить
.env
bots/*/config.env
machines/client1/bot/config.env
**/cron_notify.env
config/alertmanager.yml

# Логи и данные
remote-logs/
*.log
*.xlsx

# Временные файлы
*.tmp
__pycache__/
*.pyc
projects/campus-secrets/
*.zip

# TLS-ключ веб-панели — генерируется на сервере (docker-entrypoint.sh),
# root-owned внутри /data, что ломало ежечасный git-бэкап (kamran не может
# прочитать root-only ssl.key → git add падает → 4 дня без единого коммита).
# Приватному ключу в репозитории (даже приватном) вообще не место.
data/webui/ssl.key
data/webui/ssl.crt

# Данные БД и загрузки (на сервере, бэкапятся отдельно)
data/webui/webui.db
data/webui/avatars/
data/webui/voices/
data/webui/announces/
data/webui/hf_cache/
data/helpdesk/helpdesk.db
data/helpdesk/uploads/

# Бэкапы и временные файлы
*.bak
*.bak2
*_t.tmp.png
