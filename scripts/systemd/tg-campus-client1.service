[Unit]
Description=Telegram бот Клиент 1а (кнопки, музыка по SSH на клиент)
After=network.target

[Service]
Type=simple
User=root
# Защита от дубликатов — wrapper убивает старые и держит lock
ExecStart=/home/kamran/campus-infra/scripts/start-bot-once.sh client1 /opt/tg-campus-bot/bot_client1.py
Restart=on-failure
RestartSec=10
WorkingDirectory=/opt/tg-campus-bot

[Install]
WantedBy=multi-user.target
