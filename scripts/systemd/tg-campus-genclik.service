[Unit]
Description=Telegram бот Genclik (vm1)
After=network.target

[Service]
Type=simple
User=root
# Защита от дубликатов — wrapper убивает старые и держит lock
ExecStart=/home/kamran/campus-infra/scripts/start-bot-once.sh genclik /opt/tg-campus-bot/bot_genclik.py
Restart=on-failure
RestartSec=10
WorkingDirectory=/opt/tg-campus-bot

[Install]
WantedBy=multi-user.target
