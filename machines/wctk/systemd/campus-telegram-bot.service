[Unit]
Description=Telegram campus bot — wctk
After=network-online.target campus-mpv.service
Wants=network-online.target

[Service]
User=wctk
Group=wctk
WorkingDirectory=/home/wctk/telegram-campus-bot
ExecStart=/usr/bin/python3 -u /home/wctk/telegram-campus-bot/bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
