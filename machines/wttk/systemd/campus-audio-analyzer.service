[Unit]
Description=Campus Audio FFT Analyzer
After=campus-mpv.service

[Service]
Type=simple
User=wttk
ExecStart=/usr/bin/python3 /home/wttk/campus-monitoring/audio-analyzer.py
Restart=always
RestartSec=5
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

[Install]
WantedBy=multi-user.target
