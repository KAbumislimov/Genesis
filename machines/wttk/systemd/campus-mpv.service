[Unit]
Description=Campus MP3 player (mpv idle) — wttk
After=sound.target network.target pulseaudio.service

[Service]
Type=simple
User=wttk
Group=audio
PermissionsStartOnly=true
ExecStartPre=/bin/bash -c 'mkdir -p /run/campus-player && chown wttk:audio /run/campus-player && chmod 775 /run/campus-player'
ExecStart=/usr/bin/mpv \
  --no-video \
  --idle=yes \
  --force-window=no \
  --audio-display=no \
  --input-ipc-server=/run/campus-player/mpv.sock \
  --ao=pulse
Restart=always
RestartSec=3
StartLimitIntervalSec=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
