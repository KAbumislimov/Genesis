[Unit]
Description=Telegram campus bot — cgtk
After=network-online.target campus-mpv.service
Wants=network-online.target

[Service]
User=cgtk
Group=cgtk
WorkingDirectory=/home/cgtk/telegram-campus-bot
ExecStart=/usr/bin/python3 -u /home/cgtk/telegram-campus-bot/bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
