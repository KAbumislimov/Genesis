[Unit]
Description=Telegram campus bot — wttk
After=network-online.target campus-mpv.service
Wants=network-online.target

[Service]
User=wttk
Group=wttk
WorkingDirectory=/home/wttk/telegram-campus-bot
ExecStart=/usr/bin/python3 -u /home/wttk/telegram-campus-bot/bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
