[Unit]
Description=Campus MP3 player (mpv idle) — client1
After=sound.target network.target

[Service]
Type=simple
User=client1
Group=audio
PermissionsStartOnly=true
ExecStartPre=/bin/bash -c 'mkdir -p /run/campus-player && chown client1:audio /run/campus-player && chmod 775 /run/campus-player'
ExecStart=/usr/bin/mpv \
  --no-video \
  --idle=yes \
  --force-window=no \
  --audio-display=no \
  --volume-max=160 \
  --input-ipc-server=/run/campus-player/mpv.sock \
  --audio-device=alsa/default
Restart=always
RestartSec=3
StartLimitIntervalSec=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
