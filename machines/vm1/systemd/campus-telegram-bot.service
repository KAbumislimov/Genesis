[Unit]
Description=Telegram campus bot — vm1
After=network-online.target campus-mpv.service
Wants=network-online.target

[Service]
User=vm1
Group=vm1
WorkingDirectory=/home/vm1/telegram-campus-bot
ExecStart=/usr/bin/python3 -u /home/vm1/telegram-campus-bot/bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
