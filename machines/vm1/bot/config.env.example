# Бот vm1 — полный интерфейс как Narimanov/nctk
# Скопируйте в config.env и заполните.

# Токен бота от @BotFather (отдельный бот для vm1 или тот же что для nctk)
BOT_TOKEN=your_bot_token_here
# ID группы для логов (как на nctk)
LOG_GROUP_ID=your_narimanovskaya_group_id
# Папка с треками Kamran Music
MUSIC_ROOT=/home/vm1/Landau/Kamran Music
