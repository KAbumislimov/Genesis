[Unit]
Description=Campus Audio FFT Analyzer
After=campus-mpv.service

[Service]
Type=simple
Environment=AUDIO_MONITOR=alsa_output.pci-0000_00_1b.0.analog-stereo.monitor
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native
ExecStart=/usr/bin/python3 %h/campus-monitoring/audio-analyzer.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
