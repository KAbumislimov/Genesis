[Unit]
Description=Campus player watchdog — проверка и перезапуск campus-mpv
After=network.target

[Service]
Type=oneshot
User=client2
ExecStart=/bin/bash -c 'systemctl --user --machine=client2@ is-active campus-mpv || sudo -u client2 XDG_RUNTIME_DIR=/run/user/$(id -u client2) systemctl --user start campus-mpv'

[Install]
WantedBy=multi-user.target
