# Бот sbtk — полный интерфейс как Client1/client1
# Скопируйте в config.env и заполните.

# Токен бота от @BotFather (отдельный бот для sbtk или тот же что для client1)
BOT_TOKEN=your_bot_token_here
# ID группы для логов (как на client1)
LOG_GROUP_ID=your_client1skaya_group_id
# Папка с треками Kamran Music
MUSIC_ROOT=/home/sbtk/Media/Kamran Music
