[Unit]
Description=Telegram campus bot — sbtk
After=network-online.target campus-mpv.service
Wants=network-online.target

[Service]
User=sbtk
Group=sbtk
WorkingDirectory=/home/sbtk/telegram-campus-bot
ExecStart=/usr/bin/python3 -u /home/sbtk/telegram-campus-bot/bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
